{
  "name": "ascs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx -r ./tests/helpers/mock-server-only.cjs --test lib/academic-term.test.ts lib/academic-programs.test.ts lib/demo/demo-accounts.test.ts lib/clearance/status.test.ts lib/admin/lifecycle.test.ts lib/auth/edge-session.test.ts lib/auth/password-transition.test.ts lib/auth/session-override.test.ts lib/reports/metrics.test.ts lib/reports/filters.test.ts lib/reports/csv.test.ts lib/reports/authorization.test.ts lib/reports/acceptance-manifest.test.ts",
    "test:integration": "tsx -r ./scripts/load-local-env.cjs -r ./tests/helpers/mock-server-only.cjs --test --test-concurrency=1 tests/integration/account-lifecycle.test.ts tests/integration/password-change.test.ts tests/integration/clearance-submission.test.ts tests/integration/signatory-workflow.test.ts tests/integration/financial-workflow.test.ts tests/integration/dean-visibility.test.ts tests/integration/clearance-completion.test.ts tests/integration/reports.test.ts tests/rules/security-boundaries.test.ts",
    "test:rules": "tsx --test tests/rules/security-boundaries.test.ts",
    "test:e2e": "playwright test",
    "test:ux": "playwright test tests/e2e/accessibility.spec.ts tests/e2e/responsive-layout.spec.ts tests/e2e/keyboard-navigation.spec.ts tests/e2e/print-clearance.spec.ts tests/e2e/theme-contract.spec.ts tests/e2e/demo-account-picker.spec.ts tests/e2e/registration-password-visibility.spec.ts",
    "test:acceptance": "tsx scripts/run-acceptance.ts",
    "emulators": "firebase emulators:start --only auth,firestore",
    "emulators:exec": "firebase emulators:exec --only auth,firestore",
    "seed:emulator": "tsx -r ./scripts/load-local-env.cjs -r ./tests/helpers/mock-server-only.cjs scripts/seed-emulator.ts",
    "reset:emulator": "tsx -r ./scripts/load-local-env.cjs -r ./tests/helpers/mock-server-only.cjs scripts/reset-emulator.ts",
    "demo:reset": "tsx -r ./scripts/load-local-env.cjs -r ./tests/helpers/mock-server-only.cjs scripts/reset-emulator.ts",
    "demo:prepare": "tsx -r ./scripts/load-local-env.cjs scripts/demo-prepare.ts",
    "docs:diagrams": "tsx scripts/render-diagrams.ts",
    "docs:screenshots": "tsx scripts/capture-documentation-screenshots.ts",
    "verify:docs": "tsx scripts/verify-documentation-assets.ts",
    "verify:vercel": "tsx scripts/verify-vercel-deployment.ts"
  },
  "dependencies": {
    "@tanstack/react-form": "^1.33.0",
    "@tanstack/react-query": "^5.101.2",
    "daisyui": "^5.6.13",
    "firebase": "^12.15.0",
    "firebase-admin": "^14.1.0",
    "jose": "^6.2.3",
    "lucide-react": "^1.23.0",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "firebase-tools": "^15.26.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.9",
    "typescript": "^5"
  }
}
